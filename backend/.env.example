# Copie para backend/.env e preencha. Nunca envie o .env para o GitHub.
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://usuario:senha@localhost:5432/fiscalizaai

# chave longa e aleatória (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# primeiro administrador (só é criado se ADMIN_PASSWORD tiver 8 caracteres ou mais)
ADMIN_NAME=Administrador Principal
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=superadmin

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# fotos das ocorrências
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# opcional: busca de endereços
GEOAPIFY_API_KEY=
